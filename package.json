{
  "name": "codeti-baseball-faq-aggregator",
  "version": "1.0.0",
  "private": true,
  "description": "Codeti take-home: aggregate unique FAQ questions for baseball players whose names contain exactly 3 letter a's",
  "type": "module",
  "scripts": {
    "scrape": "tsx src/scraper/index.ts",
    "scrape:a": "tsx src/scraper/index.ts --letters a",
    "server": "tsx src/server/index.ts",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/shared/normalize.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  }
}